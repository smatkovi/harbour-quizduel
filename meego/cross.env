# Rust-Cross-Einstellungen für den N9/N950-Holer — identisch zu passviewer/meego.
# Statisch gegen musl (Harmattan hat glibc 2.10; dagegen zu binden scheitert).
# Toolchain liegt auf dem Build-Rechner unter /tmp/rust; ein beliebiges
# *-meego/tools/toolchain.sh richtet sie nach einem Neustart wieder ein.
export ZIEL=armv7-unknown-linux-musleabi
export RUSTUP_HOME=${RUSTUP_HOME:-/tmp/rust/rustup}
export CARGO_HOME=${CARGO_HOME:-/tmp/rust/cargo}
export PATH="$CARGO_HOME/bin:$PATH"

# C-Anteile (ring) brauchen einen Cross-C-Compiler MIT musl-Headern; clang allein
# fände /usr/include des Build-Rechners. Gelinkt wird mit rust-lld gegen Rusts libc.a.
export MUSL=${MUSL:-/tmp/rust/arm-linux-musleabi-cross}
export CC_armv7_unknown_linux_musleabi="$MUSL/bin/arm-linux-musleabi-gcc"
export AR_armv7_unknown_linux_musleabi="$MUSL/bin/arm-linux-musleabi-ar"
export CFLAGS_armv7_unknown_linux_musleabi="-march=armv7-a -mfloat-abi=soft"
